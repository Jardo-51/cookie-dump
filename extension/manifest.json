{
  "manifest_version": 3,
  "name": "Cookie Dump",
  "version": "0.1.0",
  "description": "Saves the cookies of chosen websites into local files.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Cookie Dump settings"
  }
}
